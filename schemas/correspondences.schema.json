{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Future video-to-asset correspondence output (not generated by bootstrap)",
  "type": "object",
  "required": ["schema_version", "case_id", "asset_id", "frame_domain", "pixel_domain", "method", "predictions"],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string"},
    "asset_id": {"type": "string"},
    "frame_domain": {"const": "active"},
    "pixel_domain": {"const": "native_1280x720"},
    "method": {"type": "string"},
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["active_index", "query_id", "pixel_xy", "visibility", "candidates", "abstained"],
        "properties": {
          "active_index": {"type": "integer", "minimum": 0},
          "query_id": {"type": "string"},
          "pixel_xy": {"type": ["array", "null"], "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
          "visibility": {"enum": ["visible", "occluded", "out_of_frame", "unknown"]},
          "candidates": {"type": "array", "items": {"$ref": "anchor.schema.json"}},
          "abstained": {"type": "boolean"}
        }
      }
    }
  }
}
