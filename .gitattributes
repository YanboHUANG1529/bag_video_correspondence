# 统一以 LF 入库，避免 Windows/Linux 协作时整文件 diff。
* text=auto eol=lf

# 脚本与文档按文本处理
*.py     text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.yaml   text eol=lf
*.csv    text eol=lf
*.txt    text eol=lf
*.obj    text eol=lf
*.xml    text eol=lf

# 二进制：永不转换换行、永不尝试合并
*.png    binary
*.jpg    binary
*.jpeg   binary
*.mp4    binary
*.npz    binary
*.npy    binary
*.zip    binary
*.7z     binary
